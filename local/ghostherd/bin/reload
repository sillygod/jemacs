#!/usr/bin/env bash
# reload — put edited ghostherd files into the running Emacs, without
# restarting it.  See docs/development.org.
#
# Usage: bin/reload [--force] FILE...
#
#   *.el      every function and macro defined again -- byte-compiled --
#             every constant set again; a variable keeps its value -- the sessions, timers
#             and caches are the running herd, not code.  A new add-hook
#             or advice-add on a named function is run too (idempotent);
#             one on a lambda, and any other top-level form, is not run
#             and is named -- a changed struct or mode wants a restart.
#             Any package's .el, not ghostherd's alone (e.g. pr-view).
#   ui/...    the herd page loaded again -- in Emacs or in a browser tab
#             -- back on the tab it was on, a room too.  xwapp's ui/ too.
#   server/.. the sidecar restarted -- not while an ask is open, whose
#             answer would have nowhere to go; --force restarts it anyway.
#
# Needs emacsclient to reach the Emacs the herd runs in.

set -euo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)
kit=$(dirname "$here")/xwapp/ui
force=
el=()
ui=
server=

# Reload only what the live Emacs actually loads.  Every git worktree has
# its own copy of every file; reloading one into the single running Emacs
# would overwrite the live defuns with another branch's.  So, for an .el,
# refuse any file that is not the one the live Emacs loads for that library
# -- whatever its package, ghostherd or pr-view or another -- found by
# `find-library-name' and followed to its source by `file-truename' (not
# the .elc a build directory may hold).  A ui/ or server/ file is tied to
# its package's checkout the same way, by that package's own library.  The
# guard steps aside when the live Emacs cannot be asked (no Emacs, or the
# library not on its load-path): the reload would fail at emacsclient
# anyway.
lib_file() {  # the .el the live Emacs loads for library $1, truename; or empty
  emacsclient --eval \
    "(or (ignore-errors (file-truename (find-library-name \"$1\"))) \"\")" \
    2>/dev/null | sed 's/^"//; s/"$//' || true
}
lib_dir() { local f; f=$(lib_file "$1"); { [ -n "$f" ] && dirname "$f"; } || true; }

live_gh=$(lib_dir ghostherd)   # the live ghostherd checkout (its page, sidecar)
live_xw=$(lib_dir xwapp)       # the live xwapp checkout (the shared kit)

refuse() {  # $1 = the arg, $2 = what the live Emacs loads there
  echo "reload: $1 is not what the live Emacs loads there:" >&2
  echo "          $2" >&2
  echo "       reloading a worktree's or stale copy would overwrite the live code; reload the one it loads." >&2
  exit 3
}
under() { case $1 in "$2"/*) return 0 ;; *) return 1 ;; esac; }

for arg in "$@"; do
  if [ "$arg" = --force ]; then force=1; continue; fi
  [ -e "$arg" ] || { echo "reload: no such file: $arg" >&2; exit 2; }
  path=$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")
  real=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$arg" 2>/dev/null || printf '%s' "$path")
  case $path in
    "$here"/server/*)
      [ -n "$live_gh" ] && ! under "$real" "$live_gh" && refuse "$arg" "$live_gh/"
      server=1 ;;
    "$here"/ui/*)
      [ -n "$live_gh" ] && ! under "$real" "$live_gh" && refuse "$arg" "$live_gh/"
      ui=1 ;;
    "$kit"/*)
      [ -n "$live_xw" ] && ! under "$real" "$live_xw" && refuse "$arg" "$live_xw/"
      ui=1 ;;
    *.el)
      live=$(lib_file "$(basename "$arg" .el)")
      [ -n "$live" ] && [ "$real" != "$live" ] && refuse "$arg" "$live"
      el+=("$path") ;;
    *) echo "reload: not an .el, ui/ or server/ file: $arg" >&2; exit 2 ;;
  esac
done
[ ${#el[@]} -gt 0 ] || [ -n "$ui" ] || [ -n "$server" ] || {
  sed -n '5,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

say() { sed 's/^"//; s/"$//'; }

lisp_string() { local s=${1//\\/\\\\}; printf '"%s"' "${s//\"/\\\"}"; }

for file in ${el[@]+"${el[@]}"}; do
  emacsclient --eval "
(progn
 (require 'bytecomp)
 (let* ((file $(lisp_string "$file"))
       ;; As \`load' would: a constant may be made from where its file is.
       (load-file-name file) (load-true-file-name file)
       (done 0) (kept 0) (skipped nil) (failed nil) (slow nil)
       (byte-compile-warnings nil)
       (run (lambda (form)
              (condition-case err
                  (progn (eval form t) (setq done (1+ done))
                         ;; Compiled as it is defined: what a reload defines
                         ;; runs for hours after it, and interpreted the herd's
                         ;; code ran up to several times slower.
                         (when (and (memq (car-safe form) '(defun defmacro defsubst cl-defun cl-defmacro))
                                    (symbolp (cadr form)))
                           (condition-case nil (byte-compile (cadr form))
                             (error (push (cadr form) slow)))))
                (error (push (format \"%s (%s)\" (cadr form) (error-message-string err))
                             failed))))))
  (with-temp-buffer
    (insert-file-contents file)
    (goto-char (point-min))
    (condition-case nil
        (while t
          (let* ((form (read (current-buffer)))
                 (head (car-safe form)))
            (cond
             ((memq head '(defun defmacro defsubst define-inline defalias
                           cl-defun cl-defmacro cl-defgeneric cl-defmethod defconst))
              (funcall run form))
             ((memq head '(defvar defvar-local defcustom))
              (if (boundp (cadr form)) (setq kept (1+ kept))
                (funcall run form)))
             ((eq head 'defface)
              (if (facep (cadr form)) (setq kept (1+ kept))
                (funcall run form)))
             ;; A new add-hook or advice-add on a *named* function is
             ;; idempotent -- the symbol is in the hook once, pointing at the
             ;; freshly-defined function -- so run it: a changed file's new
             ;; hook registers without a restart.  One on a lambda would be
             ;; added afresh each reload, so it is left for you, named below.
             ((and (memq head '(add-hook advice-add))
                   (let ((fn (nth (if (eq head 'add-hook) 2 3) form)))
                     (and (memq (car-safe fn) '(quote function))
                          (symbolp (cadr fn)) (cadr fn))))
              (funcall run form))
             ((memq head '(require provide declare-function eval-when-compile defgroup)))
             (head (push head skipped)))))
      (end-of-file nil)))
  (format \"%s: %d defined, %d kept%s%s%s\"
          (file-name-nondirectory file) done kept
          (if skipped
              (concat \", not run: \"
                      (mapconcat #'symbol-name (delete-dups (nreverse skipped)) \" \"))
            \"\")
          (if slow
              (concat \", left uncompiled: \" (mapconcat #'symbol-name (nreverse slow) \" \"))
            \"\")
          (if failed
              (concat \", FAILED: \" (string-join (nreverse failed) \"; \"))
            \"\"))))" | say
done

if [ -n "$ui" ]; then
  emacsclient --eval '
(if (not (and (boundp (quote ghostherd-memory-page--app))
              (xwapp-live-p ghostherd-memory-page--app)))
    "herd page: not open"
  (xwapp-reload ghostherd-memory-page--app)
  "herd page: loaded again")' | say
fi

if [ -n "$server" ]; then
  if open=$("$here/bin/herd" asks 2>/dev/null | python3 -c '
import json, sys
print(sum(a.get("status") in ("queued", "delivered") for a in json.load(sys.stdin)["asks"]))'); then
    if [ "$open" != 0 ] && [ -z "$force" ]; then
      echo "sidecar: $open ask(s) open, left running (--force restarts it)" >&2
      exit 1
    fi
  fi
  emacsclient --eval '
(if (and (ghostherd-memory-healthy-p) (not (ghostherd-memory--process-live-p)))
    (format "sidecar: the one on %s was not started by this Emacs; stop it, then reload again"
            (ghostherd-memory--where))
  (ghostherd-memory-stop)
  (sleep-for 0.5)
  (ghostherd-memory-start)
  (format "sidecar: restarted on %s" (ghostherd-memory--where)))' | say
fi
