#!/usr/bin/env bash
# ghostherd — drive the herd in a running Emacs from a shell.
#
# The in-Emacs commands are already reachable from an agent's own terminal
# via `ghostel_cmd'. This is for everything else: a Makefile, a git hook, a
# CI step, another shell.
#
# Usage: ghostherd <command> [args...]
#
#   list                     sessions as JSON
#   state NAME               one session as JSON
#   read NAME [LINES]        recent output
#   send NAME TEXT           paste text, do not submit
#   prompt NAME TEXT         submit a prompt
#   message TO TEXT [FROM]   attributed message
#   handoff TO TEXT [FROM]   send, then watch and notify (returns at once)
#   keys NAME KEY...         send keystrokes, e.g. esc / C-c / down
#   interrupt NAME           Escape
#   abort NAME               C-c
#   report NAME STATE [WHY]  what the agent says about itself:
#                            working | blocked | idle | done | auto
#   whoami                   this agent's own session name
#   memory search QUERY [N]  search imported transcripts (JSON)
#   memory import [force]    import claude/grok/agy transcripts
#
# Any NAME may be `self', and FROM defaults to whoever is calling: an
# agent spawned by the herd has GHOSTHERD_SESSION in its environment.
#
# Env (set for you at spawn; override to talk to another herd):
#   GHOSTHERD_SESSION  this agent's session name; `self' and FROM read it
#   GHOSTHERD_BACKEND  ghostel or tmux, informational
#   GHOSTHERD_SOCKET   passed to emacsclient -s
#   GHOSTHERD_DRY_RUN  print the elisp instead of running it

set -euo pipefail

usage() { sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; }

die() { printf 'ghostherd: %s\n' "$1" >&2; exit 1; }

# Resolve a session argument into $who, so every command takes `self'.
#
# The env var is the only place this can come from.  emacsclient does not
# carry the caller's environment into the form it evaluates, so an Emacs
# asked "who is self" has no way to answer; the shell that holds the
# variable is the one that must substitute it.
#
# Through a global rather than by printing, because a `die' inside `$( )'
# exits only the subshell: the first version of this printed the error
# and then carried on with an empty session name.
who=
resolve() {
  case $1 in
    self)
      [ -n "${GHOSTHERD_SESSION:-}" ] ||
        die "GHOSTHERD_SESSION is not set (not running inside a herd agent?)"
      who=$GHOSTHERD_SESSION
      ;;
    *) who=$1 ;;
  esac
}

# Quote a shell string as an Emacs Lisp string literal.  Everything the
# caller passes is free text -- a prompt can contain quotes, backslashes and
# newlines -- and interpolating it raw would either break the form or let it
# inject code.
elisp_string() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# Evaluate FORM and print whatever string it returns.
#
# Not `emacsclient -e' alone: that prints the *Lisp representation*, so a
# JSON payload comes back double-escaped as "[{\"name\":...}]".  Writing to
# a file keeps the payload out of the reader's syntax entirely.
run() {
  local form=$1

  if [ -n "${GHOSTHERD_DRY_RUN:-}" ]; then
    printf '%s\n' "$form"
    return 0
  fi

  local out status
  out=$(mktemp "${TMPDIR:-/tmp}/ghostherd.XXXXXX")
  trap 'rm -f "$out"' RETURN

  # `require' first: the cmd-* entry points are not autoloaded, so in an
  # Emacs that has not opened an agent yet they would be void-function.
  #
  # `coding-system-for-write' is not optional.  Agent output is full of
  # non-ASCII -- box drawing, the ❯ in a permission prompt -- and without it
  # `write-region' calls `select-safe-coding-system', which *prompts*.  In
  # batch that is an error; in a daemon it blocks forever on a minibuffer
  # nobody can answer, wedging the server for every later call too.
  set -- --eval "(progn (require 'ghostherd)
                        (let ((coding-system-for-write 'utf-8))
                          (with-temp-file $(elisp_string "$out")
                            (insert (format \"%s\" $form)))))"
  [ -n "${GHOSTHERD_SOCKET:-}" ] && set -- -s "$GHOSTHERD_SOCKET" "$@"

  if ! emacsclient "$@" >/dev/null 2>"$out.err"; then
    status=$(cat "$out.err" 2>/dev/null || true)
    rm -f "$out.err"
    die "emacsclient failed${status:+: $status}"
  fi
  rm -f "$out.err"
  cat "$out"
}

need() {
  local want=$1 got=$2
  [ "$got" -ge "$want" ] || die "not enough arguments (see: ghostherd help)"
}

[ $# -ge 1 ] || { usage; exit 2; }
cmd=$1; shift

case $cmd in
  help|-h|--help) usage ;;

  list)  run '(ghostherd-cmd-list)' ;;

  whoami) resolve self; printf '%s\n' "$who" ;;

  state)
    need 1 $#; resolve "$1"
    run "(ghostherd-cmd-state $(elisp_string "$who"))"
    ;;

  read)
    need 1 $#; resolve "$1"
    if [ $# -ge 2 ]; then
      run "(ghostherd-read $(elisp_string "$who") $2)"
    else
      run "(ghostherd-read $(elisp_string "$who"))"
    fi
    ;;

  send)
    need 2 $#; resolve "$1"
    run "(progn (ghostherd-send $(elisp_string "$who") $(elisp_string "$2") nil)
                \"sent\")"
    ;;

  prompt)
    need 2 $#; resolve "$1"
    run "(progn (ghostherd-prompt $(elisp_string "$who") $(elisp_string "$2"))
                \"prompted\")"
    ;;

  # FROM defaults to the caller, not to "user": attributing an agent's own
  # message to the human is the bug identity exists to fix.
  message)
    need 2 $#; resolve "$1"; to=$who
    resolve "${3:-${GHOSTHERD_SESSION:-user}}"
    run "(progn (ghostherd-message $(elisp_string "$who") $(elisp_string "$to")
                                   $(elisp_string "$2") :submit t)
                \"messaged\")"
    ;;

  handoff)
    need 2 $#; resolve "$1"; to=$who
    resolve "${3:-${GHOSTHERD_SESSION:-user}}"
    run "(progn (ghostherd-handoff $(elisp_string "$to") $(elisp_string "$2")
                                   $(elisp_string "$who"))
                \"handed off\")"
    ;;

  keys)
    need 2 $#; resolve "$1"; shift
    keys=""
    for k in "$@"; do keys="$keys $(elisp_string "$k")"; done
    run "(progn (ghostherd-send-keys $(elisp_string "$who")$keys) \"sent\")"
    ;;

  interrupt)
    need 1 $#; resolve "$1"
    run "(progn (ghostherd-interrupt $(elisp_string "$who")) \"interrupted\")"
    ;;

  abort)
    need 1 $#; resolve "$1"
    run "(progn (ghostherd-abort $(elisp_string "$who")) \"aborted\")"
    ;;

  # The point of identity: this is what a CLI's own lifecycle hook calls,
  # so state stops being guessed from a rendering of the agent's screen.
  report)
    need 2 $#; resolve "$1"
    case $2 in
      working|blocked|idle|done|auto) ;;
      *) die "report: state must be working, blocked, idle, done or auto" ;;
    esac
    if [ $# -ge 3 ]; then
      why=$(elisp_string "$3")
    else
      why=nil
    fi
    run "(progn (ghostherd-report $(elisp_string "$who") '$2 $why) \"reported\")"
    ;;

  memory)
    need 1 $#
    case $1 in
      search)
        shift
        need 1 $#
        if [ $# -ge 2 ]; then
          run "(ghostherd-cmd-memory-search $(elisp_string "$1") $(elisp_string "$2"))"
        else
          run "(ghostherd-cmd-memory-search $(elisp_string "$1"))"
        fi
        ;;
      import)
        shift
        if [ "${1:-}" = "force" ]; then
          run "(ghostherd-cmd-memory-import \"force\")"
        else
          run "(ghostherd-cmd-memory-import)"
        fi
        ;;
      *) die "memory: expected search or import (see: ghostherd help)" ;;
    esac
    ;;

  *) die "unknown command: $cmd (see: ghostherd help)" ;;
esac
